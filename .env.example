# ---- Claude (extraction) ----
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# ---- YouTube Data API v3 ----
# Google Cloud Console -> APIs & Services -> Enable "YouTube Data API v3" -> Credentials -> API key
YOUTUBE_API_KEY=AIza...

# ---- Telegram ----
# Create a bot with @BotFather; get the chat id by messaging the bot then
# visiting https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=-1001234567890

# ---- Transcript proxy ----
# webshare = residential rotating (recommended), generic = your own proxy, none = direct.
# IMPORTANT: Webshare "Residential" plan only — NOT "Proxy Server" or "Static Residential".
PROXY_PROVIDER=webshare
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
# Only used when PROXY_PROVIDER=generic
PROXY_URL=

# ---- CoinGecko (demo/free key) ----
COINGECKO_API_KEY=CG-...

# ---- Behaviour ----
DISPLAY_TZ=Africa/Nairobi
# Optional healthchecks.io-style ping URL, called after each successful run
HEALTHCHECK_URL=

# ---- Optional audio fallback (off by default) ----
WHISPER_FALLBACK=false
WHISPER_API_KEY=
WHISPER_BASE_URL=https://api.groq.com/openai/v1
WHISPER_MODEL=whisper-large-v3-turbo

# ---- Paths (defaults are fine) ----
# DATA_DIR=./data
