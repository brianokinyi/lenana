[Unit]
Description=lenana daily maintenance (score, crosscheck recompute, backup, health)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=lenana
Group=lenana
WorkingDirectory=/opt/lenana
Environment=PATH=/opt/lenana/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/lenana/.venv/bin/lenana score
ExecStart=/opt/lenana/.venv/bin/lenana report --refresh-prices --send
ExecStart=/opt/lenana/.venv/bin/lenana db backup
ExecStart=/opt/lenana/.venv/bin/lenana health
TimeoutStartSec=30min

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
ReadWritePaths=/opt/lenana/data
RestrictAddressFamilies=AF_INET AF_INET6

StandardOutput=journal
StandardError=journal
SyslogIdentifier=lenana-daily
