[Unit]
Description=lenana outbox flush
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=lenana
Group=lenana
WorkingDirectory=/opt/lenana
Environment=PATH=/opt/lenana/.venv/bin:/usr/local/bin:/usr/bin:/bin
# Runs independently of the pipeline so a Telegram outage cannot strand an
# alert until the next pipeline tick.
ExecStart=/opt/lenana/.venv/bin/lenana outbox-send
TimeoutStartSec=5min

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
ReadWritePaths=/opt/lenana/data
RestrictAddressFamilies=AF_INET AF_INET6

StandardOutput=journal
StandardError=journal
SyslogIdentifier=lenana-outbox
