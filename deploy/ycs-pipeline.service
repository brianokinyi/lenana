[Unit]
Description=yt-crypto-signals pipeline (discover -> transcribe -> extract -> verify -> alert)
Documentation=https://github.com/your-user/yt-crypto-signals
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ycs
Group=ycs
WorkingDirectory=/opt/ycs
Environment=PATH=/opt/ycs/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/ycs/.venv/bin/ycs run

# A stage can legitimately take a while on a three-hour stream, but it must
# never outlive its own timer interval and overlap the next run.
TimeoutStartSec=20min

# --- hardening ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
# ProtectSystem=strict makes everything read-only except what is listed here.
ReadWritePaths=/opt/ycs/data
# IPv4/IPv6 only; the app needs no unix-domain or packet sockets.
RestrictAddressFamilies=AF_INET AF_INET6

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ycs

[Install]
WantedBy=multi-user.target
